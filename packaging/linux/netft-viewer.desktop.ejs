[Desktop Entry]
Name=<%= productName %>
Comment=<%= description %>
GenericName=<%= genericName %>
Exec=<%= name %> %U
Icon=<%= name %>
Type=Application
StartupNotify=true
StartupWMClass=<%= name %>
Categories=<%= categories.join(';') %>;
<% if (mimeType && mimeType.length) { %>MimeType=<%= mimeType.join(';') %>;
<% } %>

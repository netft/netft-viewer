{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node", "electron", "vitest/globals"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "test/electron/**/*.ts",
    "test/e2e/**/*.ts",
    "forge.config.ts",
    "playwright.config.ts",
    "vite.*.config.ts",
    "vitest.config.ts"
  ]
}
